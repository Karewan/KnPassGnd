{
	"name": "kn-pwd-gnd",
	"author": "Florent VIALATTE",
	"version": "2.0.0",
	"description": "Readable, cryptographically secure password generation with exact entropy",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Karewan/KnPassGnd.git"
	},
	"homepage": "https://github.com/Karewan/KnPassGnd#readme",
	"bugs": "https://github.com/Karewan/KnPassGnd/issues",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"browser": "./dist/index.umd.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist", "LICENSE.txt", "README.md", "CHANGELOG.md"],
	"scripts": {
		"test": "node --experimental-strip-types --test tests/*.test.mjs",
		"typecheck": "tsc --noEmit",
		"build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	}
}
